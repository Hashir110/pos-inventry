rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn() && resource.data.ownerId == request.auth.uid;
    }

    function canRead() {
      return signedIn() && (resource == null || resource.data.ownerId == request.auth.uid);
    }

    function createsOwn() {
      return signedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    function keepsOwner() {
      return request.resource.data.ownerId == resource.data.ownerId;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;

      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email;

      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['shopName', 'contact', 'address', 'receiptMessage', 'invoiceCounter']);

      allow delete: if false;
    }

    match /products/{id} {
      allow read: if canRead();
      allow create: if createsOwn();
      allow update: if isOwner() && keepsOwner();
      allow delete: if isOwner();
    }

    match /sales/{id} {
      allow read: if canRead();
      allow create: if createsOwn();
      allow update: if isOwner() && keepsOwner()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['items', 'refundedAmount', 'gatePassGenerated', 'totalAmount', 'editedAt', 'extraCharges', 'paymentMethod', 'customerId', 'customerName']);
      allow delete: if isOwner();
    }

    match /returns/{id} {
      allow read: if canRead();
      allow create: if createsOwn();
      allow update, delete: if false;
    }

    match /customers/{id} {
      allow read: if canRead();
      allow create: if createsOwn();
      allow update: if isOwner() && keepsOwner();
      allow delete: if isOwner();
    }

    match /payments/{id} {
      allow read: if canRead();
      allow create: if createsOwn();
      allow update, delete: if false;
    }

    match /expenses/{id} {
      allow read: if canRead();
      allow create: if createsOwn();
      allow update: if isOwner() && keepsOwner();
      allow delete: if isOwner();
    }

    match /gate_passes/{id} {
      allow read: if canRead();
      allow create: if createsOwn();
      allow update: if isOwner() && keepsOwner();
      allow delete: if isOwner();
    }

    match /suppliers/{id} {
      allow read: if canRead();
      allow create: if createsOwn();
      allow update: if isOwner() && keepsOwner();
      allow delete: if isOwner();
    }

    match /supplier_purchases/{id} {
      allow read: if canRead();
      allow create: if createsOwn();
      allow update: if isOwner() && keepsOwner();
      allow delete: if isOwner();
    }

    match /supplier_payments/{id} {
      allow read: if canRead();
      allow create: if createsOwn();
      allow update, delete: if false;
    }

    match /day_closings/{id} {
      allow read: if canRead();
      allow create: if createsOwn();
      allow update: if isOwner() && keepsOwner();
      allow delete: if isOwner();
    }

    match /transports/{id} {
      allow read: if canRead();
      allow create: if createsOwn();
      allow update: if isOwner() && keepsOwner();
      allow delete: if isOwner();
    }

    match /stock_transfers/{id} {
      allow read: if canRead();
      allow create: if createsOwn();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
